---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import { codeThemes } from '../lib/code-themes.mjs';
import Steps from '../components/Steps.astro';
import { icon } from '../lib/icons';
import { SITE, url } from '../lib/site';

const themes = codeThemes;
const verify = `cd ~/Downloads
shasum -a 256 -c SHA256SUMS.txt`;
const verifyOut = `Glint-1.1.0-macos-universal.zip: OK`;
const build = `brew install xcodegen
git clone https://github.com/SaiBarathR/glint.git
cd glint
./scripts/build-app.sh            # universal, ad-hoc signed: dist/Glint.app
open dist/Glint.app`;
const buildOpts = `./scripts/build-app.sh --native     # only this Mac's architecture, faster
./scripts/build-app.sh --dev-sign   # sign with your Apple Development identity
./scripts/build-app.sh --install    # also copy to /Applications and launch`;
const tests = `swift test --package-path Packages/GlintCore`;
const uninstall = `rm -rf ~/Library/Application\\ Support/Glint      # installed extensions
defaults delete dev.saibarath.glint             # settings`;
---
<Base title="Download and install" path="download/" description="Download Glint for macOS, check the archive, approve the first launch and grant Accessibility access. Or build it from source.">
  <section class="page-hero">
    <div class="container">
      <h1>Download Glint</h1>
      <p>One universal app for Apple silicon and Intel Macs running macOS 14 Sonoma or later. Free and open source under the MIT license.</p>
    </div>
  </section>

  <div class="container">
    <div class="dl-card card">
      <div class="dl-main">
        <a class="btn btn-primary btn-lg" href={SITE.latestRelease} data-download>
          <span set:html={icon('download', 18)} /> Download for Mac
        </a>
        <div class="dl-info">
          <p class="dl-file" data-download-name>Glint-&lt;version&gt;-macos-universal.zip</p>
          <p class="dl-version" data-download-version>Latest release on GitHub</p>
        </div>
      </div>
      <div class="dl-links">
        <a href={SITE.latestRelease} data-download-sums>SHA256SUMS.txt</a>
        <a href={SITE.latestRelease} data-release-notes>Release notes</a>
        <a href={SITE.releases}>All releases</a>
      </div>
    </div>

    <div class="dl-layout">
      <div class="dl-content">
        <section aria-labelledby="install">
          <h2 id="install">Install</h2>
          <Steps>
            <li>
              <h3>Check the download (optional)</h3>
              <p>Download <code>SHA256SUMS.txt</code> from the same release, put it next to the zip, and run:</p>
              <Code code={verify} lang="sh" themes={themes} defaultColor={false} data-copy />
              <p>It should print the archive's name followed by <code>OK</code>:</p>
              <Code code={verifyOut} lang="text" themes={themes} defaultColor={false} />
            </li>
            <li>
              <h3>Unzip and move Glint to Applications</h3>
              <p>Double-click the zip, then drag <strong>Glint.app</strong> into your <strong>Applications</strong> folder.</p>
            </li>
            <li>
              <h3>Approve the first launch</h3>
              <p>
                Glint is ad-hoc signed rather than notarized by Apple, so Gatekeeper blocks it the first time. Open it once and
                dismiss the warning, then open <strong>System Settings → Privacy &amp; Security</strong>, scroll to
                <strong>Security</strong> and click <strong>Open Anyway</strong> next to the message about Glint. macOS asks only once.
              </p>
              <div class="note">
                <span set:html={icon('info', 20)} />
                <p>On <strong>macOS 14 Sonoma</strong> you can instead Control-click Glint in Applications and choose <strong>Open</strong>. macOS 15 removed that shortcut for apps that aren't notarized.</p>
              </div>
            </li>
            <li>
              <h3>Grant Accessibility access</h3>
              <p>
                Glint reads your selection and pastes results through the Accessibility API. The welcome window links straight to
                the right place: <strong>System Settings → Privacy &amp; Security → Accessibility</strong>. Switch <strong>Glint</strong> on.
              </p>
              <figure class="shot">
                <img class="screenshot theme-light-only" src={url('images/settings-onboarding-light.webp')} width="1120" height="1280" alt="Glint's welcome window: Allow Accessibility access, with Grant Access and Open Settings buttons, then Try it" loading="lazy" decoding="async" />
                <img class="screenshot theme-dark-only" src={url('images/settings-onboarding-dark.webp')} width="1120" height="1280" alt="Glint's welcome window in dark mode" loading="lazy" decoding="async" />
              </figure>
            </li>
            <li>
              <h3>Select some text</h3>
              <p>In any app: a word on a web page, a line in Notes, a path in Terminal. The bar appears next to the selection. Click an action, or click anywhere else (or press <kbd>Esc</kbd>) to dismiss it.</p>
              <p>Glint lives in the menu bar. Its menu has Settings, pause and per-app switches, the extension log and update checks.</p>
            </li>
          </Steps>
        </section>

        <section aria-labelledby="updating">
          <h2 id="updating">After updating</h2>
          <p>
            Glint checks GitHub for a new release once a day (you can turn that off in Settings → General), and the menu bar
            menu shows <strong>Update Available</strong> when there is one. Download it and replace the app in Applications.
          </p>
          <div class="note warn">
            <span set:html={icon('triangle-alert', 20)} />
            <p>
              <strong>Re-enable Glint in Accessibility after every update.</strong> macOS ties the permission to the app's
              signature, and an ad-hoc signature changes with every build. Open System Settings → Privacy &amp; Security →
              Accessibility and switch Glint on again. If the switch already looks on but the bar doesn't appear, remove Glint
              from the list with <strong>−</strong> and add it again with <strong>+</strong>.
            </p>
          </div>
          <p>AppleScript extensions that control other apps, like Add to Reminders, ask for <strong>Automation</strong> permission the first time they run.</p>
        </section>

        <section aria-labelledby="source">
          <h2 id="source">Build from source</h2>
          <p>You need Xcode 15 or later and <a href="https://github.com/yonaskolb/XcodeGen">XcodeGen</a>, which generates the Xcode project from <code>project.yml</code>.</p>
          <Code code={build} lang="sh" themes={themes} defaultColor={false} data-copy />
          <p><code>scripts/build-app.sh</code> takes a few options:</p>
          <Code code={buildOpts} lang="sh" themes={themes} defaultColor={false} data-copy />
          <p>
            A build signed with <code>--dev-sign</code> keeps the same signature across rebuilds, so Accessibility stays granted
            while you work on Glint. Run the engine's tests, which also load and run every bundled and gallery extension, with:
          </p>
          <Code code={tests} lang="sh" themes={themes} defaultColor={false} data-copy />
        </section>

        <section aria-labelledby="uninstall">
          <h2 id="uninstall">Uninstall</h2>
          <ol class="plain-list">
            <li>Choose <strong>Quit Glint</strong> from its menu bar menu.</li>
            <li>Move <strong>Glint.app</strong> from Applications to the Trash.</li>
            <li>Optionally remove your installed extensions and settings:</li>
          </ol>
          <Code code={uninstall} lang="sh" themes={themes} defaultColor={false} data-copy />
          <p>You can also remove Glint from the Accessibility list in System Settings. Passwords and keys you entered in extension settings are in your login keychain under <code>dev.saibarath.glint.options</code>; delete them with Keychain Access.</p>
        </section>
      </div>

      <aside class="dl-aside" aria-label="Requirements">
        <div class="card req-card">
          <h2>Requirements</h2>
          <ul role="list">
            <li><span set:html={icon('apple', 18)} /><div><strong>macOS 14 Sonoma</strong> or later</div></li>
            <li><span set:html={icon('cpu', 18)} /><div><strong>Apple silicon or Intel</strong>, one universal app</div></li>
            <li><span set:html={icon('shield-check', 18)} /><div><strong>Accessibility</strong> permission to read selections</div></li>
            <li><span set:html={icon('package', 18)} /><div>Ad-hoc signed, <strong>not notarized</strong></div></li>
          </ul>
        </div>
        <div class="card req-card">
          <h2>Next</h2>
          <ul role="list" class="next-links">
            <li><a href={url('docs/')}>Getting started</a></li>
            <li><a href={url('extensions/')}>Browse extensions</a></li>
            <li><a href={url('docs/writing-extensions/')}>Write your own</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .dl-card { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; padding: 24px 28px; }
  .dl-main { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 22px; min-width: 0; }
  .dl-info { min-width: 0; }
  .dl-file { font: 600 15px/1.4 var(--mono); color: var(--text); overflow-wrap: anywhere; }
  .dl-version { margin-top: 2px; font-size: 14px; color: var(--text-3); }
  .dl-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 15px; }
  @media (max-width: 560px) { .dl-card { padding: 20px; } .dl-main .btn { width: 100%; } }

  .dl-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; margin: 56px 0 24px; align-items: start; }
  @media (max-width: 960px) { .dl-layout { grid-template-columns: minmax(0, 1fr); gap: 40px; } .dl-aside { order: -1; } }
  .dl-content section + section { margin-top: 64px; }
  .dl-content h2 { font-size: 28px; font-weight: 750; letter-spacing: -0.02em; margin-bottom: 24px; }
  .dl-content > section > p { color: var(--text-2); }
  .dl-content > section > p + p, .dl-content > section > * + .note, .dl-content > section > .note + p { margin-top: 16px; }
  .dl-content > section > p + :global(pre), .dl-content > section > :global(pre) + p, .dl-content > section > :global(.code-block) + p,
  .dl-content > section > p + :global(.code-block), .dl-content > section > ol + :global(.code-block), .dl-content > section > ol + :global(pre) { margin-top: 14px; }
  .dl-content :global(:not(pre) > code) { font-size: 0.88em; padding: 0.1em 0.36em; border-radius: 6px; background: var(--code-bg); border: 1px solid var(--border); overflow-wrap: anywhere; }
  .shot { margin: 16px 0 0; max-width: 420px; }
  .plain-list { margin: 0; padding-left: 1.3em; color: var(--text-2); }
  .plain-list li + li { margin-top: 6px; }

  .dl-aside { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 18px; }
  @media (max-width: 960px) { .dl-aside { position: static; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); } }
  .req-card { padding: 20px 22px; }
  .req-card h2 { font-size: 16px; font-weight: 680; }
  .req-card ul { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 12px; }
  .req-card li { display: flex; gap: 12px; align-items: flex-start; font-size: 14.5px; color: var(--text-2); line-height: 1.5; }
  .req-card li > span { flex-shrink: 0; color: var(--accent-text); margin-top: 1px; }
  .req-card li > span :global(svg) { display: block; }
  .req-card strong { color: var(--text); font-weight: 620; }
  .next-links li { font-size: 15px; }
</style>

---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import { codeThemes } from '../lib/code-themes.mjs';
import BarDemo from '../components/BarDemo.astro';
import VideoSlot from '../components/VideoSlot.astro';
import ExtIcon from '../components/ExtIcon.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { icon } from '../lib/icons';
import { SITE, url } from '../lib/site';
import { bundledExtensions, galleryExtensions } from '../lib/extensions';

const bundled = bundledExtensions();
const gallery = galleryExtensions();

const activation = [
  { icon: 'mouse-pointer-2', title: 'Drag to select', text: 'Select with the mouse and the bar appears when you let go.' },
  { icon: 'text-cursor', title: 'Double- and triple-click', text: 'A word, a line or a paragraph. Shift-click extends the selection.' },
  { icon: 'keyboard', title: 'Keyboard selection', text: 'Optional: ⇧ with the arrow keys, or ⌘A, can show the bar too.' },
  { icon: 'clipboard-paste', title: 'Long press for Paste', text: 'Hold the mouse in an empty text field to get a Paste bar.' },
  { icon: 'command', title: 'Hotkeys', text: 'A global shortcut shows the bar on demand, and any action can have its own.' },
  { icon: 'eye-off', title: 'Stay out of the way', text: 'Hold a key while selecting to keep the bar hidden, or turn Glint off per app.' },
];

const builtins = [
  { icon: 'search', name: 'Search', text: 'Your search engine: Google, DuckDuckGo, Kagi, Brave and more, or a custom URL.' },
  { icon: 'copy', name: 'Cut, Copy, Paste', text: 'From the bar. Hold ⇧ on Copy to append to the clipboard.' },
  { icon: 'clipboard-type', name: 'Paste and Match Style', text: 'Plain text that takes on the surrounding style.' },
  { icon: 'compass', name: 'Open Links', text: 'Every URL in the selection. ⌘ opens in the background.' },
  { icon: 'mail', name: 'New Email', text: 'Start a message to a selected address.' },
  { icon: 'phone', name: 'Call', text: 'Call a selected number with FaceTime or your iPhone.' },
  { icon: 'folder-search', name: 'Reveal in Finder', text: 'Show a selected file path in Finder.' },
  { icon: 'book-a', name: 'Look Up', text: 'The macOS dictionary definition.' },
  { icon: 'spell-check', name: 'Spelling', text: 'Suggestions for a misspelled word. Pick one to replace it.' },
  { icon: 'bold', name: 'Bold, Italic, Underline', text: 'Format rich text where the app supports it.' },
  { icon: 'volume-2', name: 'Speak', text: 'Read the selection aloud, in the voice you choose.' },
  { icon: 'hash', name: 'Word Count', text: 'Words, characters, lines and sentences.' },
  { icon: 'calculator', name: 'Calculate', text: 'Evaluate 12 * (3 + 4) and paste or copy the result.' },
  { icon: 'puzzle', name: 'Install Extension', text: 'Appears when the selection is an extension snippet.' },
];

const safety = [
  { icon: 'clipboard-check', title: 'Your clipboard comes back', text: 'When an action pastes through the clipboard, Glint puts what you had there back afterwards. If you copy something yourself in the meantime, your copy wins.' },
  { icon: 'laptop', title: 'Nothing leaves your Mac', text: 'Glint has no account, analytics or server. Text only goes somewhere when you run an action that sends it, like a web search. The optional daily update check asks GitHub for the latest release and sends nothing else.' },
  { icon: 'shield-check', title: 'Untrusted configs stay contained', text: 'Extension configs from snippets, links and downloaded files are read in a separate helper process with a deadline, so a malformed or hostile file can\'t hang or crash Glint.' },
  { icon: 'hand', title: 'No code runs before you agree', text: 'Installing shows what an extension is and which kinds of actions it has. None of its scripts or JavaScript run until you click Install.' },
];

const shout = `#glint
name: Shout
icon: symbol:megaphone
after: paste-result
shell script: tr '[:lower:]' '[:upper:]'`;

const showcase = ['translate', 'change-case', 'format-json', 'sort-lines', 'reminders', 'base64', 'markdown-link', 'ask-claude'];
const showcaseExts = showcase.map((s) => bundled.find((e) => e.slug === s)).filter((e): e is NonNullable<typeof e> => !!e);
---
<Base path="">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Free and open source · macOS 14+</span>
        <h1>Select text.<br /><span class="hl">Act on it.</span></h1>
        <p class="hero-lead">
          Glint is a small, native menu-bar app for macOS. Select text in any app and a bar of actions appears right next
          to it: search, copy, paste, translate, change case, calculate, and anything you add yourself.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={SITE.latestRelease} data-download>
            <span set:html={icon('download', 18)} /> Download for Mac
          </a>
          <a class="btn btn-secondary btn-lg" href={url('extensions/')}>Browse extensions</a>
        </div>
        <p class="hero-meta">
          <span data-download-version>Universal app for Apple silicon and Intel</span>
          <span aria-hidden="true">·</span>
          <a href={url('download/')}>Install steps</a>
        </p>
      </div>
      <div class="hero-demo">
        <BarDemo />
        <p class="hero-demo-hint">Try the buttons. In Glint, they act on whatever you selected, in any app.</p>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="videos-title">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">See it work</span>
        <h2 class="section-title" id="videos-title">Two minutes with Glint</h2>
      </div>
      <div class="videos">
        <VideoSlot file="demo.mp4" poster="demo-poster.webp" title="Glint demo" caption="Walkthrough: installing, the built-in actions and adding an extension." />
        <VideoSlot file="promo.mp4" poster="promo-poster.webp" title="Glint promo" caption={'The short version. Music: "Wallpaper" by Kevin MacLeod (incompetech.com), CC BY 4.0.'} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="activation-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Activation</span>
        <h2 class="section-title" id="activation-title">However you select, it's there</h2>
        <p class="section-lead">Glint works in any app that shares its selection through the macOS Accessibility API, and falls back to a quick copy for the rest.</p>
      </div>
      <ul class="feature-grid" role="list">
        {activation.map((a) => (
          <li class="feature card">
            <span class="feature-icon" set:html={icon(a.icon, 20)} />
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt" aria-labelledby="actions-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Built in</span>
        <h2 class="section-title" id="actions-title">The actions you reach for most</h2>
        <p class="section-lead">Each one only appears when it makes sense: Open Link for links, Call for phone numbers, Cut only where you can edit. Switch any of them off, reorder them, or give them a hotkey.</p>
      </div>
      <ul class="actions-grid" role="list">
        {builtins.map((b) => (
          <li class="action-item">
            <span class="action-icon" set:html={icon(b.icon, 18)} />
            <div>
              <h3>{b.name}</h3>
              <p>{b.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="modifiers card">
        <h3>Hold a key to change what an action does</h3>
        <dl>
          <div><dt><kbd>⇧</kbd> Shift</dt><dd>Copy the result instead of pasting it. For links and searches, copy the URL.</dd></div>
          <div><dt><kbd>⌘</kbd> Command</dt><dd>Open URLs in the background, without bringing the browser forward.</dd></div>
          <div><dt><kbd>⌥</kbd> Option</dt><dd>The alternate behaviour: plain-text paste, a search's alternate URL, descending sort.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ext-title">
    <div class="container ext-grid">
      <div>
        <span class="eyebrow">Extensions</span>
        <h2 class="section-title" id="ext-title">Add your own actions in a few lines</h2>
        <p class="section-lead">
          An extension is a snippet of YAML, a shell script in any language, AppleScript, JavaScript, a key combo, a macOS
          Service or a Shortcuts shortcut. Select a snippet like this one anywhere, even on this page, and click
          <strong>Install Extension</strong> in the bar.
        </p>
        <div class="ext-links">
          <a class="btn btn-primary" href={url('docs/writing-extensions/')}>Write an extension</a>
          <a class="btn btn-secondary" href={url('extensions/')}>See all {bundled.length + gallery.extensions.length}</a>
        </div>
        <p class="ext-compat">
          Glint also reads the PopClip snippet and <code>.popclipext</code> formats, so most existing extensions work unchanged.
        </p>
      </div>
      <div class="ext-side">
        <div class="ext-code">
          <Code code={shout} lang="yaml" themes={codeThemes} defaultColor={false} />
        </div>
        <p class="ext-count">{bundled.length} extensions come with Glint, including:</p>
        <ul class="chips" role="list">
          {showcaseExts.map((e) => (
            <li class="chip"><ExtIcon icon={e.icon} size="sm" /> {e.name}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="look-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Appearance</span>
        <h2 class="section-title" id="look-title">Looks like it belongs on your Mac</h2>
        <p class="section-lead">Light or dark to match the system. Icons, text or both, in three sizes, above or below the selection.</p>
      </div>
      <div class="bars">
        <figure>
          <img class="bar-shot" style="width:505px" src={url('images/bar-light-medium-iconsOnly.webp')} width="1010" height="82" alt="Glint's bar in light mode, icons only: Search, Cut, Copy, Paste, Look Up, Bold, Translate, Change Case, Emoji, Wikipedia and a calculated result" loading="lazy" decoding="async" />
          <figcaption>Icons, light</figcaption>
        </figure>
        <figure class="wide-only">
          <img class="bar-shot" style="width:1012px" src={url('images/bar-dark-medium-iconsAndText.webp')} width="2024" height="82" alt="Glint's bar in dark mode with icons and text labels" loading="lazy" decoding="async" />
          <figcaption>Icons and text, dark</figcaption>
        </figure>
        <figure class="narrow-only">
          <img class="bar-shot" style="width:505px" src={url('images/bar-dark-medium-iconsOnly.webp')} width="1010" height="82" alt="Glint's bar in dark mode, icons only" loading="lazy" decoding="async" />
          <figcaption>Icons, dark</figcaption>
        </figure>
        <figure class="wide-only">
          <img class="bar-shot" style="width:695px" src={url('images/bar-light-small-textOnly.webp')} width="1390" height="70" alt="Glint's bar in light mode, small, text labels only" loading="lazy" decoding="async" />
          <figcaption>Text only, small</figcaption>
        </figure>
      </div>
      <div class="settings-shot">
        <img class="screenshot theme-light-only" src={url('images/settings-appearance-light.webp')} width="1520" height="1176" alt="Glint Settings, Appearance pane: preview, and choices for what the bar shows, its size, theme and position" loading="lazy" decoding="async" />
        <img class="screenshot theme-dark-only" src={url('images/settings-appearance-dark.webp')} width="1520" height="1176" alt="Glint Settings, Appearance pane in dark mode" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="safety-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Privacy and safety</span>
        <h2 class="section-title" id="safety-title">Careful with your text</h2>
        <p class="section-lead">Glint reads what you select so it can act on it. Here is what it does with it, and what it doesn't.</p>
      </div>
      <ul class="safety-grid" role="list">
        {safety.map((s) => (
          <li class="safety card">
            <span class="feature-icon" set:html={icon(s.icon, 20)} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
      <p class="safety-more">
        Password managers, Keychain Access, the login window and Screen Sharing are excluded by default.
        <a href={url('docs/safety-and-limits/')}>How Glint handles extensions</a>
      </p>
    </div>
  </section>

  <DownloadCTA />
</Base>

<style>
  .hero { padding: 72px 0 56px; position: relative; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 56px; align-items: center; }
  .hero h1 { font-size: clamp(42px, 6.4vw, 68px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.05; }
  /* "Act on it." looks selected, like text under Glint's bar */
  .hl { background: var(--amber); color: #1c1917; border-radius: 0.12em; padding: 0 0.08em; margin-left: -0.08em;
        box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .hero-lead { margin-top: 22px; font-size: 19px; line-height: 1.6; color: var(--text-2); max-width: 540px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 16px; font-size: 14.5px; color: var(--text-3); }
  .hero-demo-hint { margin-top: 16px; text-align: center; font-size: 14px; color: var(--text-3); }
  @media (max-width: 920px) {
    .hero { padding: 48px 0 32px; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 44px; }
    .hero-copy { text-align: center; }
    .hero-lead { margin-left: auto; margin-right: auto; }
    .hero-actions, .hero-meta { justify-content: center; }
  }
  @media (max-width: 480px) {
    .hero-actions .btn { width: 100%; }
  }

  .videos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  @media (max-width: 820px) { .videos { grid-template-columns: minmax(0, 1fr); } }

  .alt { background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .feature-grid, .safety-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .feature-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .safety-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 900px) { .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .feature-grid, .safety-grid { grid-template-columns: minmax(0, 1fr); } }
  .feature, .safety { padding: 22px 22px 24px; }
  .feature h3, .safety h3 { font-size: 17px; font-weight: 680; margin-top: 14px; }
  .feature p, .safety p { margin-top: 6px; color: var(--text-2); font-size: 15px; line-height: 1.6; }
  .feature-icon {
    display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 11px;
    background: var(--pill); color: var(--pill-fg); box-shadow: var(--shadow-sm);
  }
  .feature-icon :global(svg) { width: 20px; height: 20px; display: block; }
  .safety-more { margin-top: 22px; color: var(--text-2); font-size: 15px; }

  .actions-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 36px; }
  @media (max-width: 760px) { .actions-grid { grid-template-columns: minmax(0, 1fr); } }
  .action-item { display: flex; gap: 14px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .action-icon {
    display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; flex-shrink: 0;
    border-radius: 9px; background: var(--surface); border: 1px solid var(--border); color: var(--text);
  }
  .action-icon :global(svg) { width: 18px; height: 18px; display: block; }
  .action-item h3 { font-size: 15.5px; font-weight: 650; }
  .action-item p { margin-top: 2px; font-size: 14.5px; color: var(--text-2); line-height: 1.55; }

  .modifiers { margin-top: 36px; padding: 24px; }
  .modifiers h3 { font-size: 17px; font-weight: 680; }
  .modifiers dl { margin: 16px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px 28px; }
  .modifiers dt { font-weight: 650; display: flex; align-items: center; gap: 8px; }
  .modifiers dd { margin: 6px 0 0; color: var(--text-2); font-size: 14.5px; line-height: 1.55; }
  @media (max-width: 760px) { .modifiers dl { grid-template-columns: minmax(0, 1fr); } }

  .ext-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  @media (max-width: 900px) { .ext-grid { grid-template-columns: minmax(0, 1fr); gap: 36px; } }
  .ext-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .ext-compat { margin-top: 20px; font-size: 14.5px; color: var(--text-3); }
  .ext-compat code { font-size: 0.9em; }
  .ext-code :global(pre.astro-code) { font-size: 14.5px; padding: 20px 22px; box-shadow: var(--shadow); }
  .ext-count { margin-top: 22px; font-size: 14.5px; color: var(--text-3); }
  .chips { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px 5px 5px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border); font-size: 14px; font-weight: 550; color: var(--text);
  }

  .bars { display: grid; gap: 22px; justify-items: center; }
  .bars figure { margin: 0; width: 100%; display: flex; flex-direction: column; align-items: center; }
  .bar-shot { width: auto; max-width: 100%; height: auto; }
  .bars .narrow-only { display: none; }
  @media (max-width: 760px) { .bars .wide-only { display: none; } .bars .narrow-only { display: flex; } }
  .bars figcaption { margin-top: 8px; font-size: 13.5px; color: var(--text-3); }
  .settings-shot { margin: 48px auto 0; max-width: 760px; }
</style>
